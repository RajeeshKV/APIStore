{
  "AllowedHosts": "*",

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kromic-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithProcessId", "WithThreadId" ]
  },

  "Sentry": {
    "//": "Dsn is intentionally empty so the DSN is never committed. Supply it at runtime via the Sentry__Dsn environment variable (or user-secrets/appsettings.Production.json). An empty Dsn disables error monitoring entirely and the API still starts normally. Unhandled exceptions are reported by GlobalExceptionMiddleware, which consumes them before Sentry's own middleware can observe them.",
    "Dsn": "",
    "Environment": "",
    "Release": "",
    "TracesSampleRate": "0.0",
    "Debug": false
  },

  "Database": {
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },

  "Jwt": {
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },

  "RateLimit": {
    "WindowSeconds": 60,
    "PermitLimit": 100,
    "QueueLimit": 0,
    "AuthWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "OtpWindowSeconds": 60,
    "OtpPermitLimit": 5,
    "LeadWindowSeconds": 3600,
    "LeadPermitLimit": 6
  },

  "Cache": {
    "DefaultExpiryMinutes": 60,
    "ShortExpiryMinutes": 5,
    "SizeLimit": 1024
  },

  "BackgroundWorker": {
    "OutboxIntervalSeconds": 15,
    "OutboxBatchSize": 50,
    "OutboxMaxRetries": 5,
    "EmailIntervalSeconds": 30,
    "EmailBatchSize": 20
  },

  "Leads": {
    "//": "Where Get Started enquiries are emailed. Empty is allowed: the lead is still stored, only the notification is lost, and each submission logs the gap.",
    "NotificationEmail": "rajeeshkva2z@gmail.com",
    "NotificationName": "Website Enquiries"
  },

  "Support": {
    "//": "AdminNotificationEmail is intentionally left empty. Set Support__AdminNotificationEmail in the environment; an empty value disables only the administrative alert and is logged on every ticket.",
    "AdminNotificationEmail": "",
    "AdminNotificationName": "Support Team",
    "DefaultAutoCloseIdleHours": 72,
    "TicketNumberPrefix": "TKT",
    "InvoiceNumberPrefix": "INV"
  },

  "Webhook": {
    "ToleranceMinutes": 5,
    "IdempotencyWindowHours": 24
  }
}
