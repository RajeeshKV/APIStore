{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },

  "Database": {
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false
  },

  "App": {
    "Environment": "Development"
  }
}
