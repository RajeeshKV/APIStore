# =============================================================
# Kromic Commerce — Environment Variable Template
# =============================================================
# Copy this file to .env and fill in real values for local dev.
# The .env file is gitignored and must NEVER be committed.
#
# All keys here map to strongly typed Options classes in
# KromicCommerce.Infrastructure/Configuration/.
#
# DEPLOYMENT MODEL
# ----------------
# Each customer/store runs their own backend instance.
# All provider credentials are customer-specific and come from
# environment variables (or a secrets manager) — never hard-coded.
#
# REQUIRED vs OPTIONAL
# --------------------
# Required keys:  Application will FAIL to start if missing.
# Optional keys:  Application starts normally; the feature is disabled.
#                 Do NOT set [Required] on optional provider settings.
#
# SENSITIVE VALUES
# ----------------
# JWT signing key, OAuth secrets, payment secrets, API keys, and
# the bootstrap secret are all sensitive. They must:
#   - Come from environment variables or a secrets manager
#   - Never be committed to version control
#   - Never appear in API responses or logs
#
# How to obtain credentials:
#   Database   — PostgreSQL (local: docker run --name kromic-pg -e POSTGRES_PASSWORD=... -p 5432:5432 postgres:16)
#   JWT key    — openssl rand -base64 32
#   Google OAuth — https://console.cloud.google.com > APIs & Services > Credentials
#   Razorpay   — https://dashboard.razorpay.com > Settings > API Keys
#   Brevo      — https://app.brevo.com > Account > SMTP & API > API Keys
#   Cloudinary — https://cloudinary.com > Dashboard
#   SMS        — provider-specific (see Sms:Provider below)
# =============================================================

# --- Application ---------------------------------------------
App__ApiBaseUrl=http://localhost:5000
App__FrontendUrl=http://localhost:3000
App__Environment=Development
# One-time bootstrap secret — used to create the first admin account
# Generate a strong random value; keep it private and rotate after bootstrap
App__BootstrapSecret=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET
#
# Database migration on startup.
# Set to false locally (run migrations manually via `dotnet ef database update`).
# Set to true in production (Render env var) so the container auto-migrates on deploy.
# The application will FAIL to start if migration is enabled and the DB is unreachable.
App__Migrate=false

# --- Database ------------------------------------------------
# Format: Host=localhost;Port=5432;Database=kromic;Username=postgres;Password=...
Database__ConnectionString=Host=localhost;Port=5432;Database=kromic_dev;Username=postgres;Password=CHANGE_ME

# --- JWT -----------------------------------------------------
# Must be at least 32 characters. Use a random generator.
Jwt__SigningKey=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=kromic-commerce
Jwt__Audience=kromic-commerce-api
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=30

# --- Google OAuth --------------------------------------------
# Set Enabled=true and fill credentials to allow Google sign-in.
# When false the /auth/google endpoints return a business error at runtime;
# the application starts and all other features remain available.
# Register OAuth 2.0 credentials at https://console.cloud.google.com
# Redirect URI must be registered: {App__ApiBaseUrl}/api/v1/auth/google/callback
GoogleOAuth__Enabled=false
GoogleOAuth__ClientId=CHANGE_ME.apps.googleusercontent.com
GoogleOAuth__ClientSecret=CHANGE_ME
GoogleOAuth__RedirectUri=http://localhost:5000/api/v1/auth/google/callback

# --- Razorpay ------------------------------------------------
# Set Enabled=true and fill credentials to accept online payments.
# When false payment initiation endpoints return a business error at runtime;
# the application starts and all other features remain available.
# Test keys are safe to use for local development.
# Get them at https://dashboard.razorpay.com > Settings > API Keys
Razorpay__Enabled=false
Razorpay__KeyId=rzp_test_CHANGE_ME
Razorpay__KeySecret=CHANGE_ME
Razorpay__WebhookSecret=CHANGE_ME

# --- Brevo (Transactional Email) -----------------------------
# Set Enabled=true and fill credentials to send transactional emails via Brevo.
# When false emails are silently dropped (no-op); useful for local dev.
# https://app.brevo.com > Account > SMTP & API > API Keys
Brevo__Enabled=false
Brevo__ApiKey=xkeysib-CHANGE_ME
Brevo__SenderEmail=noreply@example.com
Brevo__SenderName=Kromic Store

# --- Cloudinary (Media Storage) ------------------------------
# https://cloudinary.com > Dashboard
Cloudinary__CloudName=CHANGE_ME
Cloudinary__ApiKey=CHANGE_ME
Cloudinary__ApiSecret=CHANGE_ME
Cloudinary__UploadFolder=kromic-dev

# --- SMS Provider --------------------------------------------
# Set Enabled=true and configure a provider to send OTP/notification SMS.
# When false a no-op SMS provider is used — OTPs are still generated and stored
# in the database but messages are never sent. Safe for local dev.
# Supported provider names: Twilio, TextLocal, Fast2SMS
# ProviderSettings keys are provider-specific — see docs/27-SMS-Providers-Implementation.md
Sms__Enabled=false
Sms__Provider=Fast2SMS
Sms__ProviderSettings__ApiKey=CHANGE_ME

# --- Tracking Provider ---------------------------------------
# Supported provider names: Delhivery, Shiprocket, Manual (default)
# ProviderSettings keys are provider-specific — see docs/29-Tracking-Provider-Implementation.md
Tracking__Provider=Manual
Tracking__ProviderSettings__ApiKey=CHANGE_ME

# --- Analytics / Frontend Tracking ---------------------------
# These IDs are PUBLIC — safe to expose to the browser via /store/settings.
# Leave blank to disable the corresponding tracking integration.
# The frontend reads these and injects the scripts client-side.
# Do NOT add secret API keys here — only browser-safe public IDs.
#
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Tracking__GoogleAnalyticsMeasurementId=G-XXXXXXXXXX
#
# Meta (Facebook) Pixel ID (numeric string)
# Tracking__MetaPixelId=1234567890123456

# --- CORS ----------------------------------------------------
# Comma-separated origins are NOT supported here; use separate env vars per origin
# or configure in appsettings.json for multiple origins.
# For a single origin the double-underscore array syntax is:
Cors__AllowedOrigins__0=http://localhost:3000

# --- Rate Limiting -------------------------------------------
RateLimit__WindowSeconds=60
RateLimit__PermitLimit=100
RateLimit__QueueLimit=0
RateLimit__AuthWindowSeconds=60
RateLimit__AuthPermitLimit=10
RateLimit__OtpWindowSeconds=60
RateLimit__OtpPermitLimit=5

# --- Cache ---------------------------------------------------
Cache__DefaultExpiryMinutes=60
Cache__ShortExpiryMinutes=5
Cache__SizeLimit=1024

# --- Background Worker ---------------------------------------
BackgroundWorker__OutboxIntervalSeconds=15
BackgroundWorker__OutboxBatchSize=50
BackgroundWorker__OutboxMaxRetries=5
BackgroundWorker__EmailIntervalSeconds=30
BackgroundWorker__EmailBatchSize=20

# --- Webhook -------------------------------------------------
Webhook__ToleranceMinutes=5
Webhook__IdempotencyWindowHours=24

# =============================================================
# CUSTOMER / STORE CONFIGURATION GUIDE
# =============================================================
#
# Each key below belongs to a specific configuration category.
# Read this before deploying a new customer instance.
#
# REQUIRED FOR ALL DEPLOYMENTS
# ----------------------------
#   Database__ConnectionString          — PostgreSQL connection string
#   Jwt__SigningKey                     — min 32 chars random secret
#   App__BootstrapSecret                — one-time admin creation secret
#   App__ApiBaseUrl                     — public-facing API URL
#   App__FrontendUrl                    — storefront URL (for CORS)
#   Cloudinary__CloudName               — media storage (REQUIRED for image uploads)
#   Cloudinary__ApiKey                  — Cloudinary API key
#   Cloudinary__ApiSecret               — Cloudinary API secret (sensitive)
#
# CUSTOMER-SPECIFIC — configure before enabling the feature
# ----------------------------------------------------------
#   Razorpay__Enabled=true              — enable online payments
#   Razorpay__KeyId                     — public key shown in checkout widget
#   Razorpay__KeySecret                 — SENSITIVE: never exposed in API responses
#   Razorpay__WebhookSecret             — SENSITIVE: for webhook signature verification
#
#   GoogleOAuth__Enabled=true           — enable Google sign-in
#   GoogleOAuth__ClientId               — Google OAuth client ID (shown in auth flow)
#   GoogleOAuth__ClientSecret           — SENSITIVE: never exposed in API responses
#   GoogleOAuth__RedirectUri            — must be registered in Google Console
#
#   Brevo__Enabled=true                 — enable customer-managed transactional email
#   Brevo__ApiKey                       — SENSITIVE: never exposed in API responses
#   Brevo__SenderEmail                  — verified sender email in Brevo account
#   Brevo__SenderName                   — display name for outbound emails
#
# OPTIONAL — application starts normally if not set
# -------------------------------------------------
#   Sms__Enabled=true                   — enable SMS/OTP delivery
#   Sms__Provider                       — Fast2SMS | Twilio | TextLocal
#   Sms__ProviderSettings__ApiKey       — SENSITIVE
#
#   Tracking__Provider                  — Manual (default) | Delhivery | Shiprocket
#   Tracking__ProviderSettings__ApiKey  — SENSITIVE (leave blank for Manual)
#
# =============================================================

# --- Sentry (Optional — Production Error Monitoring) -------------------------
# Sentry captures unhandled exceptions and sends them to your Sentry project.
# The application starts normally when this is not configured.
# Get your DSN at https://sentry.io > Project > Settings > Client Keys (DSN)
#
# NEVER commit a real DSN. It is not a secret per se (it's in browser code too)
# but it is deployment-specific and should come from environment variables.
#
# Sentry__Dsn=https://PUBLIC_KEY@INGEST_HOST/PROJECT_ID
#
# Optional: trace sampling (0.0 = disabled, 1.0 = 100% of requests sampled)
# Sentry__TracesSampleRate=0.1
#
# Optional: release identifier for sentry releases / source-maps (e.g. git SHA)
# Sentry__Release=abc123def456
